MODEL_DIR=../skin-disease-classifier
TOP_K=3

# Local fallback.
LEDGER_BACKEND=local

# Main app talks to the gateway API on port 8080.
FABRIC_LEDGER_API_URL=http://127.0.0.1:8080

# Values below are filled in by scripts/fabric/01-bootstrap-network.ps1.
FABRIC_SAMPLES_DIR=../fabric-samples
FABRIC_BIN_DIR=../fabric-samples/bin
FABRIC_TEST_NETWORK_DIR=../fabric-samples/test-network
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=prediction-ledger
FABRIC_CHAINCODE_PATH=./fabric/chaincode/prediction-ledger-go

FABRIC_ORDERER_ADDRESS=localhost:7050
FABRIC_ORDERER_CA=../fabric-samples/test-network/organizations/ordererOrganizations/example.com/orderers/orderer.example.com/msp/tlscacerts/tlsca.example.com-cert.pem
FABRIC_ORDERER_TLS_HOSTNAME_OVERRIDE=orderer.example.com

FABRIC_PEER_ADDRESS=localhost:7051
FABRIC_PEER_LOCALMSPID=Org1MSP
FABRIC_PEER_MSPCONFIGPATH=../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp
FABRIC_PEER_TLS_ROOTCERT_FILE=../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt

CORE_PEER_TLS_ENABLED=true
CORE_PEER_LOCALMSPID=Org1MSP
CORE_PEER_ADDRESS=localhost:7051
CORE_PEER_MSPCONFIGPATH=../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp
CORE_PEER_TLS_ROOTCERT_FILE=../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
